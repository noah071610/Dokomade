{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "type": "command",
        "command": "node \"dist/hooks/on-prompt.js\""
      }
    ],
    "afterFileEdit": [
      {
        "type": "command",
        "command": "node \"dist/hooks/on-tool.js\""
      }
    ],
    "stop": [
      {
        "type": "command",
        "command": "node \"dist/hooks/on-stop.js\""
      }
    ]
  }
}
